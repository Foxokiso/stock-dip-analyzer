{
  "name": "stock-dip-analyzer",
  "private": true,
  "version": "2.2.0",
  "description": "Desktop market research workspace: Finviz screeners and futures, Yahoo Finance technical analysis, dip scores and alerts.",
  "homepage": "https://github.com/Foxokiso/stock-dip-analyzer",
  "author": "Foxokiso <119351547+Foxokiso@users.noreply.github.com>",
  "desktopName": "stock-dip-analyzer.desktop",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "wait-on tcp:127.0.0.1:5174 && cross-env NODE_ENV=development electron .",
    "start": "node scripts/start.mjs",
    "setup": "npm install",
    "test": "node --test tests/*.test.js",
    "build:renderer": "vite build",
    "test:ui": "node scripts/verify-ui.mjs && node scripts/verify-alerts.mjs",
    "test:live": "node scripts/verify-live-electron.mjs",
    "test:finviz": "node scripts/verify-finviz-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "26.18.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "linkedom": "^0.18.14",
    "lucide-react": "^0.576.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^7.3.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.stockdipanalyzer.app",
    "productName": "DDS response",
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false
    },
    "nsis": {
      "include": "assets/installer.nsh"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "synopsis": "Market research workspace for stock dips",
      "syncDesktopName": true,
      "artifactName": "stock-dip-analyzer-${version}-${arch}.${ext}"
    }
  }
}
