# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Packaged application and installers (electron-builder output)
release/

# Code-signing material; electron-builder auto-loads electron-builder.env
electron-builder.env
*.pfx
*.p12

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Browser verification output
artifacts/

# Cloudflare Worker build/local artifacts (sync-worker/ has its own .gitignore too)
sync-worker/node_modules/
sync-worker/dist/
sync-worker/.cloudflare/
sync-worker/.wrangler/
sync-worker/.dev.vars*
!sync-worker/.dev.vars.example
sync-worker/.env*
!sync-worker/.env.example

# The alert sound's source WAV, written by src/scripts/generate_audio.py; only the MP3 ships
src/assets/*.wav
